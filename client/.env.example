# Your live domain (used for SEO links, sitemap.xml and robots.txt)
VITE_SITE_URL=https://worklancer.org
VITE_CONTACT_EMAIL=info@worklancers.com
VITE_WHATSAPP_NUMBER=923356665416
# Free key from https://web3forms.com - form submissions are emailed to you.
# Leave blank and forms will hand off to WhatsApp instead.
VITE_WEB3FORMS_KEY=
# Google reCAPTCHA v3 (needs Web3Forms PRO: the free plan rejects submissions carrying a reCAPTCHA token).
# Set to true only after upgrading Web3Forms and saving the SECRET key in its dashboard (never here).
VITE_RECAPTCHA_ENABLED=false
# Site key (public). Optional: the default is set in src/utils/config.js.
VITE_RECAPTCHA_SITE_KEY=
