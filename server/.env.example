NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/worklancers
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Initial admin (used only by `npm run seed`)
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (image uploads) - leave blank if not configured
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (email notifications) - leave blank if not configured
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_EMAIL=info@worklancers.com
